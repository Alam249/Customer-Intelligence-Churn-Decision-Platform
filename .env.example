# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=customer_intelligence
POSTGRES_USER=ci_user
POSTGRES_PASSWORD=change_me

# ---- Application ----
LOG_LEVEL=INFO
ENVIRONMENT=local

# ---- LLM analyst layer (Step 21) ----
# Set ONE of these (ANTHROPIC_API_KEY takes priority if both are set).
# Neither is required for Steps 1-20 — only for POST /analyst/ask and the
# "Ask the Analyst" dashboard page.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
